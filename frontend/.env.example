# ==========================================
# BrandQube Frontend Environment Variables
# ==========================================

# Backend API Base URL (used for fetching client logos, galleries, contact/career forms)
# Local Development:
NEXT_PUBLIC_API_URL=http://localhost:4000

# Production (e.g., when your backend is deployed on Render/Railway):
# NEXT_PUBLIC_API_URL=https://your-backend-service.onrender.com
